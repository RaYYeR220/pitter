# The web app mounts the service under /api, so it reads every variable of the service as well.
# service/.env.example documents each one with its default; this file lists what a deployment must set.
# Copy to .env.local and fill in. Nothing here has a secret default.

# --- Chain and contracts (from contracts/deployments/<chainId>.json) -------------------------------------------
# 143 = Monad mainnet, 10143 = Monad testnet.
CHAIN_ID=10143
# Node the server uses. May carry an API key; it never reaches the browser.
RPC_URL=https://testnet-rpc.monad.xyz
TOKEN_ADDRESS=
COVER_BOOK_ADDRESS=
COVER_POOL_ADDRESS=
WEATHER_INDEX_ADDRESS=

# --- Keys: 32-byte hex, each role its own key ------------------------------------------------------------------
UNDERWRITER_PRIVATE_KEY=
RELAYER_PRIVATE_KEY=
REPORTER_PRIVATE_KEY=

# --- Keeper ----------------------------------------------------------------------------------------------------
# Shared secret for /api/cron/tick, at least 24 characters. Schedule that endpoint every five minutes.
CRON_SECRET=

# --- Practice mode: test networks only. The service refuses to start with this on chain 143. --------------------
SANDBOX_ENABLED=false
# Shared secret between this server and its own service handlers, at least 24 characters. Never sent to a browser.
SANDBOX_SECRET=
# Index key of the simulator area (the cell at latitude 0, longitude 0 is 18446751804650688016).
SANDBOX_SIMULATOR_KEY=

# --- Paid cover over HTTP --------------------------------------------------------------------------------------
X402_ENABLED=false

# --- Storage ---------------------------------------------------------------------------------------------------
# Postgres connection string. Unset: everything is kept in memory, which suits one long-running process only.
DATABASE_URL=

# --- Browser ---------------------------------------------------------------------------------------------------
# Node the browser reads balances and cover from. Must be public: it is compiled into the page.
# Unset: the public node of the chain.
NEXT_PUBLIC_RPC_URL=
