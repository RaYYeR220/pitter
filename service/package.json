{
  "name": "@cover/service",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" vitest.config.ts"
  },
  "dependencies": {
    "@cover/core": "workspace:*",
    "@x402/core": "2.28.0",
    "@x402/evm": "2.28.0",
    "pg": "^8.23.1",
    "viem": "2.57.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.9",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "prettier": "^3.6.2",
    "typescript": "5.9.3",
    "vitest": "^5.0.4"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 120
  }
}
