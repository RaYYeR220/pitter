# Every setting of the service. Copy to .env and fill in; blank values count as unset.
# Nothing here has a secret default: keys and shared secrets must be provided.

# --- Chain -----------------------------------------------------------------------------------------------------
# 143 = Monad mainnet, 10143 = Monad testnet, 31337 = local anvil.
CHAIN_ID=10143
# JSON-RPC endpoint. May carry an API key; it is masked in logs and never returned to clients.
RPC_URL=https://testnet-rpc.monad.xyz
# Path prefix the host application mounts the handlers under, e.g. /api. Empty for the root.
BASE_PATH=

# --- Contracts (from contracts/deployments/<chainId>.json) -----------------------------------------------------
TOKEN_ADDRESS=
COVER_BOOK_ADDRESS=
COVER_POOL_ADDRESS=
WEATHER_INDEX_ADDRESS=

# --- Keys: 32-byte hex, each role its own key ------------------------------------------------------------------
# Signs quotes. Must be the `underwriter` of the cover book.
UNDERWRITER_PRIVATE_KEY=
# Pays gas for relayed transactions and receives paid-cover payments. Keep it funded with MON.
RELAYER_PRIVATE_KEY=
# Signs weather reports. Must be the `reporter` of the weather index. Optional: without it the keeper only settles.
REPORTER_PRIVATE_KEY=

# --- Quotes ----------------------------------------------------------------------------------------------------
# Seconds a quote stays usable (15-600).
QUOTE_TTL_SECONDS=120
# Highest payout rate that will be quoted, in token base units per wet second (10000 = $0.01/s).
QUOTE_MAX_RATE_PER_SECOND=10000
# Longest window that will be quoted, in seconds. The book's own maximum also applies.
QUOTE_MAX_DURATION_SECONDS=43200
# Floor under every premium, in basis points of the maximum payout, whatever the pricing model says.
QUOTE_MIN_PREMIUM_BPS=100

# --- Relayer ---------------------------------------------------------------------------------------------------
# Fee cap per gas. The relayer stops sending while base fee + priority fee is above it.
RELAYER_MAX_FEE_GWEI=300
RELAYER_PRIORITY_FEE_GWEI=2
# Native balance below which the relayer stops sending, in MON.
RELAYER_MIN_BALANCE=1
# How long to wait for a receipt before reporting the outcome as unknown.
RELAYER_RECEIPT_TIMEOUT_MS=15000

# --- Rate limits: requests per minute --------------------------------------------------------------------------
RATE_QUOTE_PER_IP=60
RATE_QUOTE_PER_ADDRESS=30
RATE_RELAY_PER_IP=20
RATE_RELAY_PER_ADDRESS=10
# All relayed transactions together. This bounds what the relayer can spend per minute.
RATE_RELAY_GLOBAL=120
RATE_COVER_PER_IP=30
RATE_BLOB_PER_IP=60
RATE_BLOB_PER_ADDRESS=30
RATE_SANDBOX_PER_IP=10
# Header the hosting platform writes the client address into, and how many trusted proxies append to it.
CLIENT_IP_HEADER=x-forwarded-for
TRUSTED_PROXY_HOPS=1

# --- Keeper ----------------------------------------------------------------------------------------------------
# Shared secret for /cron/tick, at least 24 characters. Without it the endpoint stays closed.
CRON_SECRET=
# Readings per signed report (1-20) and policies per settlement transaction (1-10).
KEEPER_MAX_READINGS_PER_REPORT=20
KEEPER_SETTLE_BATCH=8
# Policies examined per tick. The keeper walks the book from the oldest open policy, this many ids at a time,
# and wraps around, so every open policy is examined at least once every (open range / this) ticks.
KEEPER_SCAN_LIMIT=500
# Policies closed with `expire` per tick, each its own transaction: those whose window ended more than the
# book's expiryGrace ago without the oracle reporting all of it. 0 turns expiry off.
KEEPER_EXPIRE_PER_TICK=4
# Most closed policies one tick walks the book's oldest-open mark over with `syncOldestOpen` (0-320), when the
# mark lags behind the oldest policy the keeper knows to be open. A provider's exit waits for that mark. 0 turns
# it off.
KEEPER_SYNC_STEPS=256
# How far back the first reading of a newly covered cell reaches. Keep it equal to the tick interval.
KEEPER_FIRST_READING_SECONDS=300
# A cell that is always observed, so the heartbeat reflects whether the weather sources answer.
KEEPER_HEARTBEAT_LAT=52.2297
KEEPER_HEARTBEAT_LON=21.0122
# How the service identifies itself to the weather sources. Name the operator and a contact.
WEATHER_USER_AGENT=cover-service

# --- Paid cover over x402 --------------------------------------------------------------------------------------
X402_ENABLED=false
X402_FACILITATOR_URL=https://x402-facilitator.molandak.org
# How long a payer's authorization stays valid.
X402_MAX_TIMEOUT_SECONDS=120

# --- Blob store ------------------------------------------------------------------------------------------------
BLOB_MAX_BYTES=262144
BLOB_MAX_PER_ADDRESS=16
# How far a request timestamp may be from the server clock.
BLOB_CLOCK_SKEW_SECONDS=300

# --- Sandbox: test networks only. The service refuses to start with this on chain 143. -------------------------
SANDBOX_ENABLED=false
# Shared secret for /sandbox/*, at least 24 characters, different from CRON_SECRET.
SANDBOX_SECRET=
# Index key of the simulator cell, decimal or 0x hex. The keeper reports this one cell from the storm switch.
SANDBOX_SIMULATOR_KEY=

# --- Storage ---------------------------------------------------------------------------------------------------
# Postgres connection string. Unset: everything is kept in memory, which suits one long-running process only.
DATABASE_URL=
