# HyperSync token: https://envio.dev/app/api-tokens (not needed on Envio Cloud, or when ENVIO_RPC_ROLE=sync)
ENVIO_API_TOKEN=

# RPC endpoint per chain. Defaults to the public Monad endpoints.
# ENVIO_RPC_URL_10143=https://testnet-rpc.monad.xyz

# What the RPC is used for: fallback (default, HyperSync does the indexing) or sync (index over RPC, no token).
# ENVIO_RPC_ROLE=fallback
