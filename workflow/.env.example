# Copy to .env (never commit it) or export these in the shell that runs the CRE CLI.

# Private key of the reporter: the address set as `reporter` in WeatherIndex. It signs every report.
REPORTER_KEY=

# Only for `cre workflow simulate --broadcast`: the key that pays for the transaction. 64 hex characters,
# without the 0x prefix. It needs MON on the target chain.
CRE_ETH_PRIVATE_KEY=
