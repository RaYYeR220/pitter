{
  "name": "@cover/workflow",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cre workflow build .",
    "hash": "cre workflow hash . --target monad-testnet --non-interactive --wasm ./binary.wasm --public_key 0x0000000000000000000000000000000000000001",
    "simulate": "cre workflow simulate . --target monad-testnet --non-interactive --trigger-index 0",
    "simulate:broadcast": "cre workflow simulate . --target monad-testnet --non-interactive --trigger-index 0 --broadcast",
    "run:local": "bun scripts/run-local.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json"
  },
  "dependencies": {
    "@chainlink/cre-sdk": "1.23.0",
    "@cover/core": "workspace:*",
    "viem": "2.57.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "bun": "1.4.3",
    "typescript": "5.9.3"
  }
}
